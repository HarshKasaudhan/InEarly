# ==============================================================================
# Inearly - Next.js Frontend Environment Variables Template
# ==============================================================================
# Copy this file to frontend/.env.local and configure your environment.

# URL pointing to the FastAPI backend API service
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional Server-side direct Groq API key for Edge/Serverless fallback
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

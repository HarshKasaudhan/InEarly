# ==============================================================================
# Inearly - FastAPI Backend Environment Variables Template
# ==============================================================================
# Copy this file to backend/.env and populate with your secure credentials.

PROJECT_NAME="Inearly Backend"
ENVIRONMENT="development"
DEBUG=true

# Allowed CORS origins for frontend web application (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase PostgreSQL Database Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Cryptographic Envelope Encryption Key (32-byte Base64 key for DPDP Act compliance)
APP_ENCRYPTION_KEY="your-base64-encoded-32-byte-key"

# Google Gemini AI Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Groq AI Configuration (Multi-model Resilient Fallback)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Data Minimization Lifecycle
DEFAULT_RETENTION_DAYS=30

# ElevenLabs High-Fidelity Audio TTS Configuration
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
